{
	"name": "lavash-center",
	"version": "1.0.0",
	"private": true,
	"packageManager": "yarn@3.5.0",
	"type": "module",
	"engineStrict": true,
	"license": "MIT",
	"scripts": {
		"dev": "vite",
		"build": "vue-tsc --noEmit && vite build --mode production",
		"watch": "vue-tsc --noEmit && vite build --mode production --watch",
		"build-initial": "vue-tsc --noEmit && vite build",
		"preview": "vue-tsc --noEmit && vite preview",
		"deploy": "vue-tsc --noEmit && vite build --mode deploy",
		"sprite": "gulp sprite",
		"fonts": "gulp fonts",
		"lint": "eslint --ext .js,.jsx,.ts,.tsx,.vue src",
		"format": "prettier --write ."
	},
	"workspaces": [
		"src/*"
	],
	"engines": {
		"node": ">=16"
	},
	"browserslist": [
		">1%",
		"not op_mini all",
		"not ie 11",
		"last 3 chrome version",
		"last 3 firefox version",
		"last 3 safari version"
	],
	"devDependencies": {
		"@types/gulp": "4.0.11",
		"@types/lodash": "4.14.195",
		"@types/node": "20.2.5",
		"@typescript-eslint/eslint-plugin": "5.59.11",
		"@typescript-eslint/parser": "5.59.11",
		"@vitejs/plugin-vue": "4.1.0",
		"@vue/eslint-config-typescript": "11.0.3",
		"autoprefixer": "10.4.14",
		"eslint": "8.42.0",
		"eslint-config-airbnb-base": "15.0.0",
		"eslint-config-prettier": "8.8.0",
		"eslint-import-resolver-alias": "1.1.2",
		"eslint-plugin-import": "2.27.5",
		"eslint-plugin-prettier": "5.0.0",
		"eslint-plugin-vue": "9.15.1",
	    "ssh2-sftp-client": "9.1.0",
		"gulp": "4.0.2",
		"gulp-flatten": "0.4.0",
		"gulp-fonter-fix": "0.0.1",
		"gulp-notify": "4.0.0",
		"gulp-plumber": "1.2.1",
		"gulp-svg-sprite": "2.0.3",
		"gulp-ttf2woff": "1.1.1",
		"gulp-ttf2woff2": "4.0.1",
		"lightningcss": "1.21.5",
		"postcss": "8.4.24",
		"postcss-sass": "0.5.0",
		"postcss-short": "5.0.0",
		"postcss-sort-media-queries": "5.2.0",
		"prettier": "3.0.0",
		"sass": "1.62.1",
		"typescript": "5.0.4",
		"vite": "4.4.3",
		"vite-plugin-eslint": "1.8.1",
		"vue-eslint-parser": "9.3.1",
		"vue-tsc": "1.4.2"
	},
	"dependencies": {
		"@popperjs/core": "2.11.8",
		"@vueform/multiselect": "2.6.2",
		"@vueform/slider": "2.1.7",
		"@vueform/toggle": "2.1.3",
		"@vuelidate/core": "2.0.2",
		"@vuelidate/validators": "2.0.2",
		"axios": "1.4.0",
		"dialog-polyfill": "0.5.6",
		"gsap": "3.12.1",
		"lodash": "4.17.21",
		"maska": "2.1.9",
		"pinia": "2.1.4",
		"v-calendar": "3.0.3",
		"vue": "3.3.4",
		"vue-awesome-paginate": "1.1.46",
		"vue-router": "4",
		"vue-toastification": "2.0.0-rc.5"
	}
}
