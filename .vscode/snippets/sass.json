		"prefix": "@mu7",
		"body": [
			"+media(\"min\", \"tablet\")",
			"  $0"
		]
	},
	"media 992 up": {
		"prefix": "@mu6",
		"body": [
			"+media(\"min\", \"tablet-xl\")",
			"  $0"
		]
	},
	"media 1024 up": {
		"prefix": "@mu5",
		"body": [
			"+media(\"min\", \"laptop\")",
			"  $0"
		]
