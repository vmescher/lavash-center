//- Пример img - +image('img/template.jpg', 'alt')
//- сниппет: img
//- Пример imgMedia - +image('img/template.jpg', 'alt', [{file:"img/template.jpg", mediaQuery:"max-width", breakpoint:"768"}])
//- сниппет: imgMedia

mixin image(file, alt="alt", items, lazy=true)
	picture
		if items
			each item in items
				source(srcset=`${BASE_URL}${item.file}` media=`(${item.mediaQuery}: ${item.mediaQuery === "max-width" ? item.breakpoint / 16 : item.breakpoint / 16}em)`)
		img(src=`${BASE_URL}${file}` alt=`${alt}` loading=`${lazy ? "lazy" : "eager"}`)&attributes(attributes)

//- Пример - +icon('icon-name').i-icon
//- сниппет: svg
mixin icon(id)
	svg(aria-hidden="true")&attributes(attributes)
		use(xlink:href=`${BASE_URL}/img/icons.svg#svg-${id}`)

include ../blocks/breadcrumbs
