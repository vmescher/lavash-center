mixin breadcrumbs(elements)
	nav.breadcrumbs 
		.breadcrumbs__wrapper.wrapper
			ul.breadcrumbs__items(itemtype="https://schema.org/BreadcrumbList")
				each breadcrumb, i in elements
					if i === elements.length - 1
						li.breadcrumbs__item(itemscope="itemscope" itemtype="http://data-vocabulary.org/Breadcrumb")
							a.breadcrumbs__link.link(href="#" aria-current="page" title=`${breadcrumb}` itemprop="item")=breadcrumb
							meta(itemprop="position" content=`${i +1}`)
					else
						li.breadcrumbs__item(itemscope="itemscope" itemtype="http://data-vocabulary.org/Breadcrumb")
							a.breadcrumbs__link.link(href="#" title=`${breadcrumb}` itemprop="item")=breadcrumb
							meta(itemprop="position" content=`${i +1}`)
