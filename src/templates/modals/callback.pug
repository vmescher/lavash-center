base-modal(id="modal-callback")
	template(#default="{close}")
		section.modal
			button(data-dialog-close aria-label="закрыть" @click="close").modal__close
				+icon('close').modal__close-icon

			.modal__wrapper
				h3.modal__title Заказать звонок

				p.modal__text Мы перезвоним вам в течение 10 минут. Укажите, пожалуйста, ваш номер телефона.

				.modal__bottom
					.modal__buttons
						button(@click="close").btn.btn--border
							span.btn__text Отмена

						button.btn.btn--color
							span.btn__text Заказать
							+icon('arrow-right').btn__icon
