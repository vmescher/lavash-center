section.page-section.error-block
	.wrapper
		.error-block__cont
			.error-block__text
				h2.page-section__title.error-block__title Ошибка сервера
				ul
					li Перезагрузите страницу
					li Проверьте подключение к интернету
					li Очистите кэш браузера
					li Отключите плагины или расширения
				.error-block__btn
					a.btn.btn--color(href="../")
						span На главную страницу

			.error-block__img
				//span.error-block__img-text 502
				img(src="/assets/img/502.svg").error-block__img-img
